# Environments & Dependencies
.venv/
__pycache__/
*.pyc
node_modules/
dist/

# What a Python build writes about the package. pip writes it again on every build, and the copy that was in git
# was made before pymupdf was a dependency, so it named the wrong packages (IN-11).
*.egg-info/

# Rust / Tauri builds
target/
src-tauri/target/

# What the Tauri build script writes from src-tauri/capabilities/. Every `cargo build` rewrites the two 120 KB
# schema files, so while they were tracked, `git status` showed a change after every build that nobody had made,
# and a real change hid in that noise (TL-08).
apps/desktop/src-tauri/gen/

# Local cache & databases
*.db
*.db-wal
*.db-shm
.app_cache/

# User vault & raw media (Keep repo lightweight & private)
*.epub
*.pdf
*.mobi
inbox/*.epub
inbox/*.pdf
inbox/*.mobi
inbox/processed/*
!inbox/processed/.gitkeep
!inbox/.gitkeep
vault/books/*
!vault/books/.gitkeep
vault/notes/*
!vault/notes/.gitkeep
vault/.import/
vault/preferences.json*

# The app writes these while you use it: saving a topic or exporting a report rewrote a tracked file, so reading a
# book made the repository dirty (TL-08). `vault/_ledger.json` is deliberately still tracked: only an import writes
# it, and it is the one vault file git keeps, which matters while DS-14 is open and the vault has no second copy.
vault/syntopicon/

# IDE & OS files
.DS_Store
Thumbs.db
.vscode/
scratch/

